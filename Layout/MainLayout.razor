@inherits LayoutComponentBase
@inject ProductCatalogService CatalogService

<div id="top" class="d-flex flex-column min-vh-100">
    <a href="#main-content" class="gh-skip-link">Bỏ qua đến nội dung chính</a>
    <SiteHeader />

    <main id="main-content" class="flex-grow-1" tabindex="-1">
        @Body
    </main>

    <SiteFooter CategoryCount="@_categoryCount" />
    <FloatingContact />
</div>

@code {
    private int _categoryCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var summary = await CatalogService.GetHomeSummaryAsync();
            _categoryCount = summary.Categories.Count;
        }
        catch
        {
            _categoryCount = 0;
        }
    }
}
