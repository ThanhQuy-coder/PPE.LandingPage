@using PPE.LandingPage.Models

<section id="gioi-thieu" class="gh-section gh-section-white">
    <div class="gh-container gh-about-grid">
        <div class="gh-about-media">
            <div class="gh-about-frame">
                <img src="@ImageUrl"
                     alt="@ImageAlt"
                     width="420"
                     height="420"
                     loading="lazy"
                     decoding="async"
                     onerror="this.onerror=null;this.src='@BrandInfo.PlaceholderImage';" />
            </div>
            <div class="gh-about-badge">
                <span class="gh-about-badge-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                </span>
                <span class="small fw-semibold text-white" style="line-height: 1.4;">
                    Đồng hành từ trang phục đến thiết bị bảo hộ
                </span>
            </div>
        </div>

        <div>
            <p class="gh-kicker">VỀ @BrandInfo.UpperShortName</p>
            <h2 class="gh-section-title">Giải pháp bảo hộ lao động phù hợp cho từng ngành nghề.</h2>
            <p class="gh-section-lead">
                <strong>@BrandInfo.LegalName</strong> hoạt động trong lĩnh vực sản xuất và phân phối quần áo bảo hộ lao động, đồng phục công nhân, đồng phục văn phòng cùng nhiều nhóm trang thiết bị bảo vệ cá nhân.
            </p>
            <p class="mt-3 mb-0 small" style="color: var(--gh-text-muted); line-height: 1.7;">
                Từ những mẫu có sẵn trong danh mục đến nhu cầu trang bị cho đội ngũ sản xuất, công trình hoặc văn phòng, khách hàng có thể tham khảo trực tiếp từng nhóm hàng và trao đổi qua hotline để được tư vấn cụ thể.
            </p>

            <div class="gh-strength-list">
                <div class="gh-strength-item">
                    <span class="gh-strength-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Sản xuất trang phục &amp; đồng phục</h3>
                        <p class="mb-0 small" style="color: var(--gh-text-muted);">
                            Cung cấp quần áo bảo hộ công nhân, đồng phục văn phòng, áo phản quang, quần áo chống cháy, chống lạnh và chống hóa chất.
                        </p>
                    </div>
                </div>

                <div class="gh-strength-item">
                    <span class="gh-strength-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Thiết bị bảo vệ cá nhân (PPE)</h3>
                        <p class="mb-0 small" style="color: var(--gh-text-muted);">
                            Giày ủng bảo hộ, găng tay, mũ, kính, bảo vệ tai, mặt nạ phòng độc, dây an toàn và thiết bị phòng cháy chữa cháy.
                        </p>
                    </div>
                </div>

                <div class="gh-strength-item">
                    <span class="gh-strength-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Tư vấn trực tiếp theo nhu cầu</h3>
                        <p class="mb-0 small" style="color: var(--gh-text-muted);">
                            Trao đổi trực tiếp qua hotline @BrandInfo.HotlineDisplay để được hỗ trợ chọn mẫu mã và nhóm sản phẩm phù hợp.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public string ImageUrl { get; set; } = BrandInfo.PlaceholderImage;

    [Parameter]
    public string ImageAlt { get; set; } = "Sản phẩm bảo hộ lao động Gia Hoàng";
}
