@using PPE.LandingPage.Models

<section id="san-pham" class="gh-section gh-section-white">
    <div class="gh-container" data-reveal>
        <div class="gh-section-header">
            <div>
                <p class="gh-kicker">SẢN PHẨM TIÊU BIỂU</p>
                <h2 class="gh-section-title">Một số mẫu bảo hộ lao động nổi bật.</h2>
            </div>
            <a href="san-pham" class="gh-btn gh-btn-navy">
                <span>Xem tất cả @(TotalProductCount > 0 ? TotalProductCount.ToString() : "") sản phẩm</span>
                <span aria-hidden="true">→</span>
            </a>
        </div>

        @if (FeaturedProducts.Count > 0)
        {
            <div class="gh-product-grid mt-4 pt-2">
                @foreach (var product in FeaturedProducts)
                {
                    <ProductCard Product="@product" />
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<ProductItem> FeaturedProducts { get; set; } = [];

    [Parameter]
    public int TotalProductCount { get; set; }
}
