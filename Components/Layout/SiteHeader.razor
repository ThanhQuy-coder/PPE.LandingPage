@using PPE.LandingPage.Models

<header class="gh-header">
    <div class="gh-topbar">
        <div class="gh-container gh-topbar-inner">
            <p class="gh-topbar-tagline">
                <span class="gh-dot" aria-hidden="true"></span>
                <span>@BrandInfo.LegalName – Thiết bị bảo hộ lao động &amp; Đồng phục doanh nghiệp</span>
            </p>
            <a class="gh-topbar-phone" href="@BrandInfo.HotlineHref" aria-label="Gọi hotline @BrandInfo.HotlineDisplay">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span>Hotline: @BrandInfo.HotlineDisplay</span>
            </a>
        </div>
    </div>

    <div class="gh-container gh-nav-bar">
        <a href="" class="gh-brand" aria-label="@BrandInfo.ShortName – Về trang chủ" @onclick="CloseMenu">
            <span class="gh-brand-logo">
                <img src="@BrandInfo.LogoUrl"
                     alt="Logo @BrandInfo.ShortName"
                     width="42"
                     height="42"
                     decoding="async" />
            </span>
            <span class="gh-brand-text">
                <span class="gh-brand-name">@BrandInfo.UpperShortName</span>
                <span class="gh-brand-sub">BẢO HỘ LAO ĐỘNG</span>
            </span>
        </a>

        <nav class="gh-nav-links" aria-label="Điều hướng chính">
            <a class="gh-nav-link" href="">Trang chủ</a>
            <a class="gh-nav-link" href="#gioi-thieu">Giới thiệu</a>
            <a class="gh-nav-link" href="#danh-muc">Danh mục</a>
            <NavLink class="gh-nav-link" href="san-pham">Sản phẩm</NavLink>
            <a class="gh-nav-link" href="#lien-he">Liên hệ</a>
        </nav>

        <div class="gh-nav-cta">
            <a class="gh-btn gh-btn-outline" href="@BrandInfo.HotlineHref">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span>Gọi @BrandInfo.HotlineDisplay</span>
            </a>
        </div>

        <button type="button"
                class="gh-menu-toggle"
                aria-label="@(_menuOpen ? "Đóng menu" : "Mở menu")"
                aria-expanded="@_menuOpen"
                aria-controls="gh-mobile-nav"
                @onclick="ToggleMenu">
            @if (_menuOpen)
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            }
            else
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            }
        </button>
    </div>

    @if (_menuOpen)
    {
        <nav id="gh-mobile-nav" class="gh-mobile-nav" aria-label="Điều hướng di động">
            <div class="gh-mobile-nav-list">
                <a class="gh-mobile-nav-link" href="" @onclick="CloseMenu">Trang chủ</a>
                <a class="gh-mobile-nav-link" href="#gioi-thieu" @onclick="CloseMenu">Giới thiệu</a>
                <a class="gh-mobile-nav-link" href="#danh-muc" @onclick="CloseMenu">Danh mục</a>
                <a class="gh-mobile-nav-link" href="san-pham" @onclick="CloseMenu">Sản phẩm</a>
                <a class="gh-mobile-nav-link" href="#lien-he" @onclick="CloseMenu">Liên hệ</a>
            </div>
            <a class="gh-btn gh-btn-primary w-100 mt-3" href="@BrandInfo.HotlineHref" @onclick="CloseMenu">
                Gọi @BrandInfo.HotlineDisplay
            </a>
        </nav>
    }
</header>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;
}
