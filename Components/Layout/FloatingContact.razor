@using PPE.LandingPage.Models

<div class="gh-floating-contact" aria-label="Kênh liên hệ nhanh">
    <a href="@BrandInfo.ZaloHref"
       target="_blank"
       rel="noopener noreferrer"
       class="gh-float-btn gh-float-zalo"
       aria-label="Nhắn tin Zalo @BrandInfo.ShortName (@BrandInfo.HotlineDisplay)">
        <span class="gh-float-icon" aria-hidden="true">
            <span class="gh-zalo-mark">Zalo</span>
        </span>
        <span class="gh-float-label">Chat Zalo</span>
    </a>

    <a href="@BrandInfo.HotlineHref"
       class="gh-float-btn gh-float-hotline"
       aria-label="Gọi Hotline @BrandInfo.HotlineDisplay">
        <span class="gh-float-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
        </span>
        <span class="gh-float-label">@BrandInfo.HotlineDisplay</span>
    </a>
</div>
