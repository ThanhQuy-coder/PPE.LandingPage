@using PPE.LandingPage.Models

<footer class="gh-footer">
    <div class="gh-container gh-footer-grid">
        <div>
            <a href="" class="gh-brand" aria-label="@BrandInfo.ShortName – Về trang chủ">
                <span class="gh-brand-logo">
                    <img src="@BrandInfo.LogoUrl"
                         alt="Logo @BrandInfo.ShortName"
                         width="42"
                         height="42"
                         loading="lazy"
                         decoding="async" />
                </span>
                <span class="gh-brand-text">
                    <span class="gh-brand-name text-white">@BrandInfo.UpperShortName</span>
                    <span class="gh-brand-sub text-white-50">BẢO HỘ LAO ĐỘNG</span>
                </span>
            </a>
            <p class="mt-3 mb-0 small" style="color: var(--gh-text-on-dark-muted); max-width: 24rem; line-height: 1.7;">
                @BrandInfo.LegalName – Sản xuất và phân phối quần áo bảo hộ lao động, đồng phục doanh nghiệp và trang thiết bị an toàn lao động.
            </p>
        </div>

        <div>
            <h2 class="gh-footer-heading">Điều hướng</h2>
            <nav class="gh-footer-links" aria-label="Điều hướng cuối trang">
                <a href="">Trang chủ</a>
                <a href="#gioi-thieu">Giới thiệu doanh nghiệp</a>
                <a href="#danh-muc">Danh mục sản phẩm</a>
                <a href="san-pham">Tất cả sản phẩm</a>
                <a href="#lien-he">Liên hệ tư vấn</a>
            </nav>
        </div>

        <div>
            <h2 class="gh-footer-heading">Thông tin liên hệ</h2>
            <p class="mb-2 fw-bold text-white" style="font-size: 0.9375rem;">@BrandInfo.LegalName</p>
            <a href="@BrandInfo.HotlineHref" class="d-inline-flex align-items-center gap-2 fw-bold" style="color: #f69364; font-size: 1rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span>Hotline: @BrandInfo.HotlineDisplay</span>
            </a>
            @if (CategoryCount > 0)
            {
                <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.65);">
                    Danh mục gồm @CategoryCount nhóm sản phẩm bảo hộ.
                </p>
            }
        </div>
    </div>

    <div class="border-top" style="border-color: rgba(255,255,255,0.1) !important;">
        <div class="gh-container gh-footer-bottom">
            <p class="mb-0">© @DateTime.UtcNow.Year @BrandInfo.LegalName.</p>
            <a href="#top" class="d-inline-flex align-items-center gap-1 text-white-50">
                <span>Trở về đầu trang</span>
                <span aria-hidden="true">↑</span>
            </a>
        </div>
    </div>
</footer>

@code {
    [Parameter]
    public int CategoryCount { get; set; }
}
