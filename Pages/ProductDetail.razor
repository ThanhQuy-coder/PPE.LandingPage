@page "/san-pham/{Id}"
@inject ProductCatalogService CatalogService

<PageTitle>@(_product is not null ? $"{_product.Name} – {BrandInfo.ShortName}" : $"Chi tiết sản phẩm – {BrandInfo.ShortName}")</PageTitle>

<section class="gh-section gh-section-cream" style="padding-top: 2.5rem;">
    <div class="gh-container">
        @if (_isLoading)
        {
            <div class="gh-state-box" role="status" aria-live="polite">
                <p class="fw-bold mb-1" style="color: var(--gh-navy);">Đang tải thông tin sản phẩm...</p>
                <p class="small mb-0" style="color: var(--gh-text-muted);">Vui lòng đợi trong giây lát.</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="gh-state-box" role="alert">
                <p class="fw-bold mb-1" style="color: var(--gh-navy);">Không thể tải thông tin sản phẩm</p>
                <p class="small mb-3" style="color: var(--gh-text-muted);">@_errorMessage</p>
                <button type="button" class="gh-btn gh-btn-primary" @onclick="LoadProductAsync">Thử lại</button>
            </div>
        }
        else if (_product is null)
        {
            <div class="gh-state-box">
                <h1 class="h4 fw-bold mb-2">Không tìm thấy sản phẩm</h1>
                <p class="small mb-4" style="color: var(--gh-text-muted);">
                    Mã sản phẩm "@Id" không tồn tại trong danh mục hiện tại.
                </p>
                <a href="san-pham" class="gh-btn gh-btn-navy">Quay lại danh sách sản phẩm</a>
            </div>
        }
        else
        {
            <nav class="gh-breadcrumb" aria-label="Đường dẫn">
                <a href="">Trang chủ</a>
                <span aria-hidden="true">/</span>
                <a href="san-pham">Sản phẩm</a>
                @if (!string.IsNullOrWhiteSpace(_product.PrimaryCategoryId))
                {
                    <span aria-hidden="true">/</span>
                    <a href="san-pham?category=@Uri.EscapeDataString(_product.PrimaryCategoryId)">@_product.PrimaryCategoryName</a>
                }
                <span aria-hidden="true">/</span>
                <span class="fw-semibold" style="color: var(--gh-navy);">@_product.Name</span>
            </nav>

            <div class="gh-detail-grid">
                <div class="gh-detail-gallery">
                    <div class="gh-detail-main-img">
                        <img src="@_activeImageUrl"
                             alt="@_product.Name"
                             width="520"
                             height="520"
                             decoding="async"
                             onerror="this.onerror=null;this.src='@BrandInfo.PlaceholderImage';" />
                    </div>

                    @if (_product.NormalizedImageUrls.Count > 1)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var imgUrl in _product.NormalizedImageUrls)
                            {
                                var isCurrent = string.Equals(imgUrl, _activeImageUrl, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="p-1 rounded border bg-white"
                                        style="width: 4.5rem; height: 4.5rem; border-color: @(isCurrent ? "var(--gh-accent)" : "var(--gh-border)") !important;"
                                        @onclick="() => _activeImageUrl = imgUrl">
                                    <img src="@imgUrl"
                                         alt="@_product.Name"
                                         width="64"
                                         height="64"
                                         style="width: 100%; height: 100%; object-fit: contain;"
                                         onerror="this.onerror=null;this.src='@BrandInfo.PlaceholderImage';" />
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="bg-white rounded-4 border p-4 p-md-5" style="border-color: var(--gh-border) !important;">
                    <a href="san-pham?category=@Uri.EscapeDataString(_product.PrimaryCategoryId)"
                       class="d-inline-block rounded-pill px-3 py-1 small fw-bold mb-3"
                       style="background-color: var(--gh-accent-soft); color: var(--gh-accent);">
                        @_product.PrimaryCategoryName
                    </a>

                    <h1 class="h2 fw-bold mb-3" style="color: var(--gh-navy);">@_product.Name</h1>

                    @if (_product.Description.Count > 0)
                    {
                        <div class="mb-4">
                            @foreach (var paragraph in _product.Description.Where(d => !string.IsNullOrWhiteSpace(d)))
                            {
                                <p class="small mb-2" style="color: var(--gh-text-body); line-height: 1.7;">@paragraph</p>
                            }
                        </div>
                    }

                    @if (_product.ConfirmedAttributes.Count > 0)
                    {
                        <h2 class="h6 fw-bold text-uppercase mb-2 mt-3" style="letter-spacing: 0.08em; color: var(--gh-text-muted);">
                            Thông tin sản phẩm
                        </h2>
                        <table class="gh-specs-table">
                            <tbody>
                                @foreach (var attr in _product.ConfirmedAttributes)
                                {
                                    <tr>
                                        <th scope="row">@attr.Key</th>
                                        <td>@attr.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <div class="mt-4 pt-3 border-top d-flex flex-column flex-sm-row gap-3" style="border-color: var(--gh-border) !important;">
                        <a href="@BrandInfo.HotlineHref" class="gh-btn gh-btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                            </svg>
                            <span>Gọi tư vấn: @BrandInfo.HotlineDisplay</span>
                        </a>
                        <a href="san-pham?category=@Uri.EscapeDataString(_product.PrimaryCategoryId)" class="gh-btn gh-btn-outline">
                            Xem cùng danh mục
                        </a>
                    </div>
                </div>
            </div>

            @if (_relatedProducts.Count > 0)
            {
                <div class="mt-5 pt-4">
                    <div class="gh-section-header mb-4">
                        <div>
                            <p class="gh-kicker">SẢN PHẨM LIÊN QUAN</p>
                            <h2 class="h4 fw-bold mt-1">Các mẫu khác trong nhóm @_product.PrimaryCategoryName</h2>
                        </div>
                        <a href="san-pham?category=@Uri.EscapeDataString(_product.PrimaryCategoryId)" class="small fw-bold" style="color: var(--gh-accent);">
                            Xem tất cả →
                        </a>
                    </div>

                    <div class="gh-product-grid">
                        @foreach (var related in _relatedProducts)
                        {
                            <ProductCard @key="related.Id" Product="@related" />
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private bool _isLoading = true;
    private string? _errorMessage;
    private ProductItem? _product;
    private string _activeImageUrl = BrandInfo.PlaceholderImage;
    private IReadOnlyList<ProductItem> _relatedProducts = [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var catalog = await CatalogService.GetCatalogAsync();
            _product = catalog.Products.FirstOrDefault(p => string.Equals(p.Id, Id, StringComparison.OrdinalIgnoreCase));

            if (_product is not null)
            {
                _activeImageUrl = _product.PrimaryImageUrl;
                _relatedProducts = catalog.Products
                    .Where(p => !string.Equals(p.Id, _product.Id, StringComparison.OrdinalIgnoreCase)
                                && p.CategoryIds.Contains(_product.PrimaryCategoryId, StringComparer.OrdinalIgnoreCase))
                    .Take(4)
                    .ToList();
            }
            else
            {
                _relatedProducts = [];
            }
        }
        catch (Exception)
        {
            _errorMessage = "Đã xảy ra sự cố khi tải dữ liệu sản phẩm. Vui lòng thử lại.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
